import java.util.*;

class Student {
    int id;
    String name;
    int age;
    String course;

    Student(int id, String name, int age, String course) {
        this.id = id;
        this.name = name;
        this.age = age;
        this.course = course;
    }

    @Override
    public String toString() {
        return "ID: " + id + " | Name: " + name + " | Age: " + age + " | Course: " + course;
    }
}

public class StudentDSAProject {
    private static Scanner sc = new Scanner(System.in);

    // DSA Structures
    private static Stack<Student> studentStack = new Stack<>();
    private static Queue<Student> studentQueue = new LinkedList<>();
    private static LinkedList<Student> studentLinkedList = new LinkedList<>();
    private static HashMap<Integer, Student> studentMap = new HashMap<>();

    public static void main(String[] args) {
        int choice;
        do {
            System.out.println("\n===== Student Management System (DSA) =====");
            System.out.println("1. Add Student");
            System.out.println("2. View All Students");
            System.out.println("3. Use Stack (Push/Pop)");
            System.out.println("4. Use Queue (Enqueue/Dequeue)");
            System.out.println("5. Use LinkedList (Add/Remove)");
            System.out.println("6. Search Student in HashMap");
            System.out.println("7. Exit");
            System.out.print("Enter choice: ");
            choice = sc.nextInt();

            switch (choice) {
                case 1 -> addStudent();
                case 2 -> viewAll();
                case 3 -> stackOperations();
                case 4 -> queueOperations();
                case 5 -> linkedListOperations();
                case 6 -> searchHashMap();
                case 7 -> System.out.println("Exiting...");
                default -> System.out.println("Invalid choice!");
            }
        } while (choice != 7);
    }

    // Add Student (adds to all structures)
    private static void addStudent() {
        System.out.print("Enter ID: ");
        int id = sc.nextInt();
        sc.nextLine();
        System.out.print("Enter Name: ");
        String name = sc.nextLine();
        System.out.print("Enter Age: ");
        int age = sc.nextInt();
        sc.nextLine();
        System.out.print("Enter Course: ");
        String course = sc.nextLine();

        Student s = new Student(id, name, age, course);

        studentStack.push(s);
        studentQueue.add(s);
        studentLinkedList.add(s);
        studentMap.put(id, s);

        System.out.println(" Student added to all structures!");
    }

    // View All Students
    private static void viewAll() {
        System.out.println("\n--- Students in Stack ---");
        for (Student s : studentStack) System.out.println(s);

        System.out.println("\n--- Students in Queue ---");
        for (Student s : studentQueue) System.out.println(s);

        System.out.println("\n--- Students in LinkedList ---");
        for (Student s : studentLinkedList) System.out.println(s);

        System.out.println("\n--- Students in HashMap ---");
        for (Student s : studentMap.values()) System.out.println(s);
    }

    // Stack Operations
    private static void stackOperations() {
        System.out.println("\nStack Operations: 1.Push  2.Pop");
        int ch = sc.nextInt();
        if (ch == 1) {
            System.out.println("Already added via Add Student option.");
        } else if (ch == 2) {
            if (!studentStack.isEmpty()) {
                System.out.println("Popped: " + studentStack.pop());
            } else {
                System.out.println("Stack is empty!");
            }
        }
    }

    // Queue Operations
    private static void queueOperations() {
        System.out.println("\nQueue Operations: 1.Enqueue  2.Dequeue");
        int ch = sc.nextInt();
        if (ch == 1) {
            System.out.println("Already added via Add Student option.");
        } else if (ch == 2) {
            if (!studentQueue.isEmpty()) {
                System.out.println("Dequeued: " + studentQueue.poll());
            } else {
                System.out.println("Queue is empty!");
            }
        }
    }

    // LinkedList Operations
    private static void linkedListOperations() {
        System.out.println("\nLinkedList Operations: 1.AddFirst  2.RemoveFirst");
        int ch = sc.nextInt();
        if (ch == 1) {
            System.out.println("Already added via Add Student option.");
        } else if (ch == 2) {
            if (!studentLinkedList.isEmpty()) {
                System.out.println("Removed: " + studentLinkedList.removeFirst());
            } else {
                System.out.println("LinkedList is empty!");
            }
        }
    }

    // HashMap Search
    private static void searchHashMap() {
        System.out.print("Enter ID to search: ");
        int id = sc.nextInt();
        if (studentMap.containsKey(id)) {
            System.out.println("Found: " + studentMap.get(id));
        } else {
            System.out.println(" Student not found!");
        }
    }
}
